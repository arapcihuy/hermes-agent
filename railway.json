{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["python", "node"],
      "phases": {
        "setup": {
          "nixPkgs": ["python3", "nodejs", "npm"],
          "cmds": ["python3 -m ensurepip", "pip3 install --upgrade pip"]
        },
        "install": {
          "cmds": ["pip3 install -r requirements.txt", "npm ci"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npx hermes gateway start"
  }
}
